// --------------- Follow model-------------------
model Follow {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  following_id String
  following    User   @relation("followings", fields: [following_id], references: [id], onDelete: Cascade)
  follower_id  String
  follower     User   @relation("followers", fields: [follower_id], references: [id], onDelete: Cascade)

  @@unique([following_id, follower_id])
  @@index([follower_id])
  @@index([following_id])
  @@index([follower_id, following_id])
  @@map("follows")
}

// ---------------Education model-------------------
model Education {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  degree      String?
  description String?
  institute   String?
  year        String?

  @@index([user_id])
  @@map("educations")
}

// ---------------Experience model-------------------
model Experience {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  company    String?
  position   String?
  location   String?
  start_date String?
  end_date   String?

  @@index([user_id])
  @@map("experiences")
}

// ---------------Skill model-------------------
model Skill {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  name String?

  @@index([user_id])
  @@map("skills")
}

// --------------- Publications model-------------------
model Publication {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  title String?
  topic String?
  link  String?
  year  String?

  @@index([user_id])
  @@map("publications")
}

// --------------- Activity model -------------------
model Activity {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  title       String?
  description String?

  @@map("activities")
}

// --------------- Report model ----------------
model Report {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  reporter_id String
  reporter    User   @relation("reporter", fields: [reporter_id], references: [id], onDelete: Cascade)

  reported_id String?
  reported    User?   @relation("reported", fields: [reported_id], references: [id], onDelete: Cascade)

  description String?

  @@map("reports")
}

model Test {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())

  user_id String
  user    User   @relation(fields: [user_id], references: [id])

  test_mode       String[]
  difficulty      difficulty
  topic           topic[]
  // Test settings
  total_attempts  Int        @default(0)
  total_questions Int
  score           Float? // end the test hole score here
  is_completed    Boolean    @default(false)

  // Relationships
  user_answers UserAnswer[]
  questions    Questions[]

  @@map("tests")
}

model UserAnswer {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())

  test_id String
  test    Test   @relation(fields: [test_id], references: [id])

  user_id String
  user    User   @relation(fields: [user_id], references: [id])

  question_id String
  question    Questions @relation(fields: [question_id], references: [id])

  // select answer option
  selected_option_id String?
  selected_option    AnswerOptions? @relation(fields: [selected_option_id], references: [id])

  // is marked as important
  is_marked Boolean @default(false)

  // is omitted
  is_omitted Boolean @default(false)

  //  is correct answer
  is_correct Boolean?

  @@map("user_answers")
}
