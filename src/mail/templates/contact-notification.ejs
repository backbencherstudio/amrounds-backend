<!DOCTYPE html>
<html>
<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
            border: 1px solid #ddd;
            border-radius: 5px;
        }
        h2 {
            color: #2c3e50;
        }
        .field {
            margin-bottom: 10px;
        }
        .label {
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>New Contact Message</h2>
        <p>Hello Admin,</p>
        <p>You have received a new contact message from <strong><%= name %></strong>.</p>
        
        <div class="field">
            <span class="label">Email:</span> <%= email %>
        </div>
        <div class="field">
            <span class="label">Subject:</span> <%= subject %>
        </div>
        <div class="field">
            <span class="label">Message:</span><br>
            <%= message %>
        </div>

        <p>Please log in to the admin panel to reply.</p>
    </div>
</body>
</html>
